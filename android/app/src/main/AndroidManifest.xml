<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- apparire sopra le altre app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- restare acceso con la notifica fissa -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- riaccendersi quando riaccendi il telefono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- la pagina 3D gira in una WebView (nessun dato esce dal telefono) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- sveglie e timer veri nell'app Orologio -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- il selfie per l'avatar dalla foto (la foto resta sul telefono) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- «chiama Giulia» e «che impegni ho oggi?»: rubrica e agenda in sola lettura, se dai il permesso -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- conversazione a voce: il microfono si usa solo mentre è aperta la finestra «Parla con…» -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- promemoria puntuali al minuto -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- assistente vocale: «chiama la mamma» chiama davvero, ma solo se dai il permesso e dici «sì» alla domanda -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- «luminosità al massimo», «rotazione automatica»: solo se lo permetti nelle Impostazioni -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- «accendi il wifi» sui telefoni con Android 9 o più vecchio -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- app che Zeph sa aprire (da Android 11 vanno dichiarate) -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.spotify.music" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="com.discord" />
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.miui.calculator" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.google.android.keep" />
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.miui.notes" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.microsoft.office.word" />
        <package android:name="com.microsoft.office.excel" />
        <package android:name="com.microsoft.office.powerpoint" />
        <package android:name="com.microsoft.office.officehubrow" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="deezer.android.app" />
        <!-- «apri Instagram»: per trovare le app installate per nome -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- si apre con il logo e «creator MaikGost», poi passa all'app -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/Zeph.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- tieni premuta l'icona: «Assistente» -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- l'assistente vocale: tasto Home tenuto premuto (se lo scegli come assistente), cuffie, scorciatoia, riquadro -->
        <activity
            android:name=".AssistActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Assistente Zeph"
            android:launchMode="singleTask"
            android:taskAffinity="it.zeph.compagno.assist"
            android:theme="@style/Zeph.Assist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ChatActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="it.zeph.compagno.chat"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".PhotoActivity"
            android:exported="false"
            android:label="Avatar dalla foto"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".TalkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="it.zeph.compagno.talk"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar" />

        <service
            android:name=".ZephService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compagno animato che resta visibile sopra le altre app" />
        </service>

        <!-- «Condividi → Zeph»: legge ad alta voce il testo condiviso -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Leggi con Zeph"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- pulsante «Zeph» nelle Impostazioni rapide -->
        <service
            android:name=".ZephTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_zeph"
            android:label="Zeph"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- i messaggi in arrivo (solo se gli dai l'accesso alle notifiche nelle Impostazioni) -->
        <service
            android:name=".MessageListener"
            android:exported="true"
            android:label="Zeph: avvisi dei messaggi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- «Comandi del telefono»: indietro, home, app recenti, screenshot, blocca schermo, scorri (solo se lo attivi tu) -->
        <service
            android:name=".ZephAccess"
            android:exported="true"
            android:label="Zeph: comandi del telefono"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/zeph_access" />
        </service>

        <receiver
            android:name=".Reminders$Fire"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
