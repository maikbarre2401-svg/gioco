# ============================================================
#  COPIA QUESTO FILE IN ".env" E COMPILA I VALORI
# ============================================================

# Chiave API di Groq (GRATIS): https://console.groq.com/keys
GROQ_API_KEY=

# ---------- TELEGRAM (facoltativo) ----------
# Token del bot, lo crei con @BotFather su Telegram (comando /newbot)
TELEGRAM_BOT_TOKEN=
# Il TUO id numerico Telegram: scrivi /id al tuo bot per scoprirlo.
# Serve per i comandi da proprietario (/pausa, /riprendi, /stato)
# e per ricevere gli avvisi quando un messaggio richiede te.
TELEGRAM_OWNER_ID=

# ---------- WHATSAPP (facoltativo) ----------
# true = collega WhatsApp (scansioni un QR code la prima volta)
WHATSAPP_ATTIVO=true
# Facoltativo: il tuo numero con prefisso, solo cifre (es. 393331234567).
# Se lo metti, invece del QR ricevi un codice di 8 caratteri da inserire
# in WhatsApp > Dispositivi collegati > Collega con numero di telefono.
WHATSAPP_NUMERO=

# ---------- PANNELLO DI CONTROLLO (pagina web) ----------
PANNELLO_PORTA=3000
# Se metti una password il pannello è raggiungibile anche da internet
# (utente: admin). Senza password è visibile solo da questo computer.
PANNELLO_PASSWORD=
